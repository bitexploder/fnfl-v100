# PRD1: the build stamp, generated on every build (not at configure): the source tree's commit and whether its tracked
# files differ from it, into OUT (a C++ file both llama-server and fnfl-drive link through fnfl-glue). OUT is written
# only when its text changes, so an unchanged tree relinks nothing.
#   cmake -DSRC=<source dir> -DOUT=<generated .cpp> -P stamp.cmake
execute_process(COMMAND git -C "${SRC}" rev-parse HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE rc ERROR_QUIET)
if (NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
else()
    execute_process(COMMAND git -C "${SRC}" diff --quiet HEAD RESULT_VARIABLE dirty ERROR_QUIET)
    if (NOT dirty EQUAL 0)
        string(APPEND commit "-dirty")
    endif()
endif()
set(text "// generated by fn/tools/stamp.cmake on every build: do not edit\n#include \"fn/fnfl.h\"\n\nconst char * fnfl_build_commit() {\n    return \"${commit}\";\n}\n")
set(old "")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
